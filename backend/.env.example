DATABASE_URL=sqlite+aiosqlite:///./videogaga-local.db
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional one-time bootstrap invitation: 16-32 random characters, never committed.
BOOTSTRAP_ADMIN_INVITE=
DATABASE_SSL_MODE=verify-full
# Comma-separated exact origins, without URL paths. Include your frontend domain.
CORS_ALLOWED_ORIGINS=http://localhost:3000
